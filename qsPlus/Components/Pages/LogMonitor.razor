@page "/logmonitor"
@using Microsoft.AspNetCore.SignalR.Client
@using qsPlus.Hubs
@using qsPlus.Services
@using qsPlus.Models
@inject NavigationManager NavigationManager
@inject SignalRConnectionService ConnectionService

<h3>Real-time Log Monitor</h3>

<!-- Collapsible Test Logs Component -->
<div class="test-logs-container">
    <div class="test-logs-header" @onclick="ToggleTestLogsVisible">
        <h4>
            <i class="oi @(isTestLogsVisible ? "oi-minus" : "oi-plus")"></i>
            Test Log Generator
        </h4>
    </div>
    
    @if (isTestLogsVisible)
    {
        <div class="test-logs-body">
            <TestLogs OnConnectionStatusChanged="HandleTestLogsConnectionChanged" />
        </div>
    }
</div>

<div class="dashboard">
    <div class="chart-container">
        <h4>Log Distribution</h4>
        
        <div class="custom-pie-chart">
            @foreach (var item in chartData.Where(d => d.Count > 0))
            {
                var percentage = _logs.Count > 0 ? (item.Count * 100 / _logs.Count) : 0;
                <div class="pie-segment" 
                     style="background-color: @item.Color; 
                            width: @(percentage)%;">
                    @if (percentage >= 10)
                    {
                        <span>@item.Level: @item.Count</span>
                    }
                </div>
            }
        </div>
        
        <div class="chart-legend">
            <div class="legend-item" @onclick="ClearFilter">
                <span class="legend-color all"></span>
                <span>All (@_logs.Count)</span>
            </div>
            <div class="legend-item" @onclick="FilterError">
                <span class="legend-color error"></span>
                <span>Error (@GetLogCountByLevel("error"))</span>
            </div>
            <div class="legend-item" @onclick="FilterWarning">
                <span class="legend-color warning"></span>
                <span>Warning (@GetLogCountByLevel("warning"))</span>
            </div>
            <div class="legend-item" @onclick="FilterInfo">
                <span class="legend-color info"></span>
                <span>Info (@GetLogCountByLevel("information"))</span>
            </div>
            <div class="legend-item" @onclick="FilterDebug">
                <span class="legend-color debug"></span>
                <span>Debug (@GetLogCountByLevel("debug"))</span>
            </div>
        </div>
    </div>

    <div class="log-container">
        @if (!string.IsNullOrEmpty(currentFilter))
        {
            <div class="filter-indicator">
                Showing only: <span class="filter-badge @currentFilter">@currentFilter</span>
                <button class="clear-filter" @onclick="ClearFilter">×</button>
            </div>
        }
        
        @foreach (var log in GetFilteredLogs())
        {
            <div class="log-entry @GetLogLevelClass(log.LogLevel)">
                <div class="log-header">
                    <span class="app-name">@log.ApplicationName</span>
                    <span class="timestamp">@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                    <span class="exception-type">@log.ExceptionType</span>
                </div>
                <div class="log-message">@log.Message</div>
                @if (!string.IsNullOrEmpty(log.StackTrace))
                {
                    <details>
                        <summary>Stack Trace</summary>
                        <pre>@log.StackTrace</pre>
                    </details>
                }
            </div>
        }
    </div>
</div>

<style>
    /* Add new styles for the test logs container */
    .test-logs-container {
        margin-bottom: 20px;
        border: 1px solid #ddd;
        border-radius: 4px;
        overflow: hidden;
    }
    
    .test-logs-header {
        padding: 10px;
        background-color: #f8f9fa;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .test-logs-header:hover {
        background-color: #e9ecef;
    }
    
    .test-logs-header h4 {
        margin: 0;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
    }
    
    .test-logs-header h4 i {
        margin-right: 8px;
    }
    
    .test-logs-body {
        padding: 15px;
        border-top: 1px solid #ddd;
    }
    
    .connection-status .badge {
        padding: 5px 8px;
    }
    
    /* Add new styles for the custom pie chart */
    .custom-pie-chart {
        display: flex;
        height: 40px;
        width: 100%;
        border-radius: 4px;
        overflow: hidden;
        margin: 15px 0;
    }
    
    .pie-segment {
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.8rem;
        overflow: hidden;
        white-space: nowrap;
        transition: all 0.3s;
    }
    
    /* Keep your existing styles below */
    .dashboard {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    .chart-container {
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        background-color: #f8f9fa;
    }
    
    .chart-legend {
        display: flex;
        flex-direction: row;
        gap: 10px;
        margin-top: 10px;
    }
    
    .legend-item {
        display: flex;
        align-items: center;
        margin: 5px 0;
        cursor: pointer;
        padding: 2px 5px;
        border-radius: 4px;
    }
    
    .legend-item:hover {
        background-color: #eee;
    }
    
    .legend-color {
        display: inline-block;
        width: 15px;
        height: 15px;
        margin-right: 5px;
        border-radius: 2px;
    }
    
    .legend-color.all {
        background: linear-gradient(45deg, #dc3545, #ffc107, #17a2b8, #6c757d);
    }
    
    .filter-indicator {
        padding: 8px;
        margin-bottom: 10px;
        background-color: #f8f9fa;
        border-radius: 4px;
        display: flex;
        align-items: center;
    }
    
    .filter-badge {
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: bold;
        color: white;
        margin: 0 5px;
    }
    
    .filter-badge.error {
        background-color: #dc3545;
    }
    
    .filter-badge.warning {
        background-color: #ffc107;
        color: #212529;
    }
    
    .filter-badge.info {
        background-color: #17a2b8;
    }
    
    .filter-badge.debug {
        background-color: #6c757d;
    }
    
    .clear-filter {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        padding: 0 5px;
    }
    
    .log-container {
        flex: 1;
        max-height: 600px;
        overflow-y: auto;
        border: 1px solid #ccc;
        padding: 10px;
    }

    .log-entry {
        margin-bottom: 10px;
        padding: 8px;
        border-radius: 4px;
        border-left: 4px solid #ccc;
    }

    .log-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 0.9em;
    }

    .exception-type {
        font-weight: bold;
    }

    .log-message {
        white-space: pre-wrap;
    }

    .error { border-left-color: #dc3545; background-color: rgba(220, 53, 69, 0.1); }
    .warning { border-left-color: #ffc107; background-color: rgba(255, 193, 7, 0.1); }
    .info { border-left-color: #17a2b8; background-color: rgba(23, 162, 184, 0.1); }
    .debug { border-left-color: #6c757d; background-color: rgba(108, 117, 125, 0.1); }
</style>

@code {
    private bool isTestLogsVisible = false;
    private List<LogMessage> _logs = new();
    private string? currentFilter = null;
    private List<LogLevelData> chartData = new();
    
    // Class to hold chart data
    public class LogLevelData
    {
        public string Level { get; set; } = "";
        public int Count { get; set; }
        public string Color { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to the log received event
        ConnectionService.LogReceived += HandleLogReceived;
        
        // Subscribe to connection changes to update UI as needed
        ConnectionService.ConnectionChanged += HandleConnectionChanged;
        
        // Initialize chart data
        UpdateChartData();
    }
    
    private async void HandleLogReceived(LogMessage log)
    {
        await InvokeAsync(() =>
        {
            _logs.Insert(0, log); // Add new logs at the top
            if (_logs.Count > 100)
                _logs.RemoveAt(_logs.Count - 1); // Limit the number of logs
            
            // Update chart data
            UpdateChartData();
            
            StateHasChanged();
        });
    }
    
    private async void HandleConnectionChanged(bool connected)
    {
        await InvokeAsync(() => StateHasChanged());
    }
    
    private void HandleTestLogsConnectionChanged(bool isConnected)
    {
        // This is now handled through the service's ConnectionChanged event
    }
    
    private void ToggleTestLogsVisible()
    {
        isTestLogsVisible = !isTestLogsVisible;
    }
    
    private void UpdateChartData()
    {
        chartData = new List<LogLevelData>
        {
            new LogLevelData { Level = "Error", Count = GetLogCountByLevel("error"), Color = "#dc3545" },
            new LogLevelData { Level = "Warning", Count = GetLogCountByLevel("warning"), Color = "#ffc107" },
            new LogLevelData { Level = "Information", Count = GetLogCountByLevel("information"), Color = "#17a2b8" },
            new LogLevelData { Level = "Debug", Count = GetLogCountByLevel("debug"), Color = "#6c757d" }
        };
    }

    private string GetLogLevelClass(string? logLevel)
    {
        return logLevel?.ToLower() switch
        {
            "error" or "critical" => "error",
            "warning" => "warning", 
            "information" => "info",
            "debug" or "trace" => "debug",
            _ => ""
        };
    }
    
    private int GetLogCountByLevel(string level)
    {
        return _logs.Count(log => 
        {
            var logLevelLower = log.LogLevel?.ToLower();
            if (level == "error")
                return logLevelLower == "error" || logLevelLower == "critical";
            else if (level == "information")
                return logLevelLower == "information" || logLevelLower == "info";
            else if (level == "debug")
                return logLevelLower == "debug" || logLevelLower == "trace";
            else
                return logLevelLower == level;
        });
    }
    
    private IEnumerable<LogMessage> GetFilteredLogs()
    {
        if (string.IsNullOrEmpty(currentFilter))
            return _logs;
            
        return _logs.Where(log => 
        {
            var logLevelLower = log.LogLevel?.ToLower();
            if (currentFilter == "error")
                return logLevelLower == "error" || logLevelLower == "critical";
            else if (currentFilter == "info")
                return logLevelLower == "information" || logLevelLower == "info";
            else if (currentFilter == "debug")
                return logLevelLower == "debug" || logLevelLower == "trace";
            else
                return logLevelLower == currentFilter;
        });
    }
    
    private void ClearFilter() => FilterByLevel(null);
    private void FilterError() => FilterByLevel("error");
    private void FilterWarning() => FilterByLevel("warning");  
    private void FilterInfo() => FilterByLevel("information");
    private void FilterDebug() => FilterByLevel("debug");

    private void FilterByLevel(string? level)
    {
        currentFilter = level;
        StateHasChanged();
    }

    public void Dispose()
    {
        // Unsubscribe from events when this component is disposed
        ConnectionService.LogReceived -= HandleLogReceived;
        ConnectionService.ConnectionChanged -= HandleConnectionChanged;
    }
}