@using System.Windows.Forms
@using qsPlus.Services
@inject SystemPerformanceService PerformanceService
@inject SystemStorageService StorageService
@* @inject FolderPickerService FolderPicker *@
@implements IDisposable
@using System.IO
@using System.Diagnostics

<!-- Add this near the top of your file -->
<link rel="stylesheet" href="css/systemStorage.css" />

<div class="container py-4">
    <div class="row row-cols-1 row-cols-md-1 g-4 mb-5">
        <div class="col">
            <div class="card performance-card h-100">
                <div class="card-body p-4">
                    @if (!storageLoaded)
                    {
                        <div class="text-center my-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Analyzing storage...</p>
                        </div>
                    }
                    else
                    {
                        <!-- Disk Information -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Disk Usage</h5>
                            <button class="btn btn-sm btn-outline-primary" @onclick="SelectCustomDirectory">
                                <i class="bi bi-folder-plus me-1"></i> Analyze Custom Folder
                            </button>
                        </div>

                        <div class="row mb-4">
                            @foreach (var disk in disks)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="@(disk.UsagePercent > 90 ? "critical" : disk.UsagePercent > 75 ? "warning" : "") 
                                            @(selectedDrive?.Name == disk.Name ? "selected" : "")">
                                        <div class="d-flex justify-content-between">
                                            <span class="label">@disk.Name (@disk.Type)</span>
                                            <span class="badge @(disk.UsagePercent > 90 ? "bg-danger" : disk.UsagePercent > 75 ? "bg-warning" : "bg-success")">
                                                @disk.UsagePercent%
                                            </span>
                                        </div>
                                        <div class="theme-text">@disk.FreeSpaceFormatted free of @disk.TotalSizeFormatted</div>
                                        <div class="progress-bar">
                                            <div class="progress" style="width: @disk.UsagePercent%"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <!-- Custom Path Input (shown when custom analysis is requested) -->
                        @if (showCustomPathInput)
                        {
                            <!-- Replace the custom path input card div -->
                            <div class="card mb-4 theme-card">
                                <div class="card-body">
                                    <h6 class="mb-3">Analyze Custom Folder</h6>
                                    <div class="input-group mb-3">
                                        <input type="text" class="form-control" placeholder="Enter folder path (e.g., C:\Users\YourName\Documents)" 
                                               @bind="customPath" />
                                        <button class="btn btn-primary" @onclick="AnalyzeCustomPath">
                                            <i class="bi bi-search me-1"></i> Analyze
                                        </button>
                                        <button class="btn btn-outline-secondary" @onclick="SelectFolderAndAnalyze">
                                            <i class="bi bi-folder me-1"></i> Browse...
                                        </button>
                                    </div>
                                    <div class="form-text">
                                        <small>Enter a folder path manually or click Browse to select a folder.</small>
                                    </div>
                                    <div class="d-flex justify-content-end mt-2">
                                        <button class="btn btn-sm btn-link" @onclick="() => showCustomPathInput = false">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        <!-- Recent directories -->
                        @if (recentDirectories.Count > 0 && !showCustomPathInput)
                        {
                            <div class="mb-4">
                                <h6 class="mb-2">Recent Folders</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var dir in recentDirectories)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" 
                                                @onclick="() => AnalyzeCustomPath(dir)">
                                            <i class="bi bi-folder me-1"></i> @GetShortPath(dir)
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        
                        <!-- Folder Analysis -->
                        @if ((selectedDrive != null || !string.IsNullOrEmpty(customPath)) && largestFolders.Any())
                        {
                            <h5 class="mb-3">
                                @if (selectedDrive != null)
                                {
                                    <span>Largest Folders on @selectedDrive.Name</span>
                                }
                                else if (!string.IsNullOrEmpty(analyzedPath))
                                {
                                    <span>Largest Folders in @GetShortPath(analyzedPath)</span>
                                }
                            </h5>
                            
                            <div class="storage-chart mb-3">
                                <div class="chart-container">
                                    @foreach (var folder in largestFolders)
                                    {
                                        <div class="chart-segment" 
                                            style="width: @folder.Percentage%" 
                                            title="@folder.Name (@folder.SizeFormatted)" 
                                            @onclick="() => OpenFolder(folder)">
                                            <div class="segment-label">@folder.Percentage%</div>
                                        </div>
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <small class="text-muted">Click on a segment to open that folder</small>
                                    @if (!string.IsNullOrEmpty(analyzedPath))
                                    {
                                        <button class="btn btn-sm btn-outline-primary" 
                                                @onclick="() => OpenFolder(new SystemStorageService.FolderInfo { Path = analyzedPath })">
                                            <i class="bi bi-folder-symlink me-1"></i> Open Current Folder
                                        </button>
                                    }
                                </div>
                            </div>
                            
                            <div class="table-responsive">
                                <table class="table table-hover theme-table">
                                    <thead class="table-header">
                                        <tr>
                                            <th scope="col">Folder</th>
                                            <th scope="col">Size</th>
                                            <th scope="col">% of Total</th>
                                            <th scope="col"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var folder in largestFolders)
                                        {
                                            <tr>
                                                <td title="@folder.Path">
                                                    <i class="bi bi-folder me-1"></i> <span class="folder-name">@folder.Name</span>
                                                </td>
                                                <td class="folder-size">@folder.SizeFormatted</td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="progress-bar" style="width: 100px">
                                                            <div class="progress" style="width: @folder.Percentage%"></div>
                                                        </div>
                                                        <span class="ms-2 percentage-value">@folder.Percentage%</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex gap-2">
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenFolder(folder)">
                                                            <i class="bi bi-folder-symlink"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => AnalyzeCustomPath(folder.Path)">
                                                            <i class="bi bi-search"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Add this section after your folder analysis table -->
                            @* @if (fileTypeAnalysis.Any()) *@
                            @* { *@
                            @*     <div class="mt-4"> *@
                            @*         <h5 class="mb-3">File Types in @GetShortPath(analyzedPath)</h5> *@
                            @*         <div class="row"> *@
                            @*             <div class="col-md-7"> *@
                            @*                 <div class="table-responsive"> *@
                            @*                     <table class="table table-hover theme-table"> *@
                            @*                         <thead class="table-header"> *@
                            @*                             <tr> *@
                            @*                                 <th scope="col">File Type</th> *@
                            @*                                 <th scope="col">Count</th> *@
                            @*                                 <th scope="col">Size</th> *@
                            @*                                 <th scope="col">% of Total</th> *@
                            @*                             </tr> *@
                            @*                         </thead> *@
                            @*                         <tbody> *@
                            @*                             @foreach (var type in fileTypeAnalysis) *@
                            @*                             { *@
                            @*                                 <tr> *@
                            @*                                     <td> *@
                            @*                                         <div class="d-flex align-items-center"> *@
                            @*                                             <span class="file-type-icon me-2" style="background-color: @type.Color"> *@
                            @*                                                 @type.Extension.TrimStart('.') *@
                            @*                                             </span> *@
                            @*                                             <span>@(string.IsNullOrEmpty(type.Description) ? type.Extension : type.Description)</span> *@
                            @*                                         </div> *@
                            @*                                     </td> *@
                            @*                                     <td>@type.Count.ToString("N0")</td> *@
                            @*                                     <td>@type.SizeFormatted</td> *@
                            @*                                     <td> *@
                            @*                                         <div class="d-flex align-items-center"> *@
                            @*                                             <div class="progress-bar" style="width: 100px"> *@
                            @*                                                 <div class="progress" style="width: @type.Percentage%; background-color: @type.Color"></div> *@
                            @*                                             </div> *@
                            @*                                             <span class="ms-2 percentage-value">@type.Percentage%</span> *@
                            @*                                         </div> *@
                            @*                                     </td> *@
                            @*                                 </tr> *@
                            @*                             } *@
                            @*                         </tbody> *@
                            @*                     </table> *@
                            @*                 </div> *@
                            @*             </div> *@
                            @*             <div class="col-md-5"> *@
                            @*                 <div class="file-type-chart"> *@
                            @*                     <canvas id="fileTypeChart" width="300" height="300"></canvas> *@
                            @*                 </div> *@
                            @*             </div> *@
                            @*         </div> *@
                            @*     </div> *@
                            @* } *@
                            <!-- Add this section for file age analysis -->
                            @if (fileAgeAnalysis.Any())
                            {
                                <div class="mt-4">
                                    <h5 class="mb-3">File Age Analysis</h5>
                                    <div class="row">
                                        <div class="col-md-7">
                                            <div class="table-responsive">
                                                <table class="table table-hover theme-table">
                                                    <thead class="table-header">
                                                        <tr>
                                                            <th scope="col">Time Period</th>
                                                            <th scope="col">Count</th>
                                                            <th scope="col">Size</th>
                                                            <th scope="col">% of Total</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var age in fileAgeAnalysis)
                                                        {
                                                            <tr>
                                                                <td>@age.Description</td>
                                                                <td>@age.Count.ToString("N0")</td>
                                                                <td>@age.SizeFormatted</td>
                                                                <td>
                                                                    <div class="d-flex align-items-center">
                                                                        <div class="progress-bar" style="width: 100px">
                                                                            <div class="progress" style="width: @age.Percentage%"></div>
                                                                        </div>
                                                                        <span class="ms-2 percentage-value">@age.Percentage%</span>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <div class="storage-item p-3">
                                                <h6>Files by Age</h6>
                                                <p class="text-muted small">Understanding when files were created can help identify old data that might be archived or deleted.</p>
                                                <button class="btn btn-sm btn-outline-primary mt-2" @onclick="AnalyzeOldFiles">
                                                    <i class="bi bi-clock-history me-1"></i> Find Files Older Than 1 Year
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else if (storageError != null)
                        {
                            <div class="alert alert-warning">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-exclamation-triangle-fill fs-2 me-3 text-warning"></i>
                                    <div>
                                        <h6 class="mb-1">Storage Analysis Error</h6>
                                        <p class="mb-1">@storageError</p>
                                        <div class="mt-2">
                                            <small>
                                                Windows restricts access to system folders for security reasons. 
                                                Try selecting a different drive or folder that you have permission to access.
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (selectedDrive != null || !string.IsNullOrEmpty(customPath))
                        {
                            <div class="text-center my-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2">
                                    @if (selectedDrive != null)
                                    {
                                        <span>Analyzing folders on @selectedDrive.Name...</span>
                                    }
                                    else
                                    {
                                        <span>Analyzing folders in @GetShortPath(customPath)...</span>
                                    }
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="text-center my-3">
                                <p>Click on a drive or select a custom folder to analyze</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private System.Threading.Timer? _timer;
    private bool isLoaded = false;
    private bool storageLoaded = false;
    private bool showCustomPathInput = false;
    private string customPath = "";
    private string analyzedPath = "";
    private List<SystemStorageService.DiskInfo> disks = new();
    private SystemStorageService.DiskInfo? selectedDrive;
    private List<SystemStorageService.FolderInfo> largestFolders = new();
    private List<string> recentDirectories = new();
    private string? storageError;
    private const int MAX_RECENT_DIRS = 5;
    private List<FileAgeInfo> fileAgeAnalysis = new();
    // private List<FileTypeInfo> fileTypeAnalysis = new();
    private bool isAnalyzingOldFiles = false;
    private List<FileInfo> oldFiles = new();
    
    protected override async Task OnInitializedAsync()
    {
        // Load performance data asynchronously
        await Task.Run(() => {
            isLoaded = true;
        });
        
        // Load storage information
        await LoadStorageData();
        
        // Update the UI
        StateHasChanged();
        
        // Set up timer for subsequent updates
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }
    
    private async Task LoadStorageData()
    {
        try
        {
            disks = StorageService.GetDriveInfo();
            storageLoaded = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            storageError = $"Error loading storage information: {ex.Message}";
        }
    }

    private void OpenFolder(SystemStorageService.FolderInfo folder)
    {
        try
        {
            if (Directory.Exists(folder.Path))
            {
                // Open the folder in Explorer
                System.Diagnostics.Process.Start("explorer.exe", folder.Path);
            }
            else
            {
                storageError = $"Folder not found: {folder.Path}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            storageError = $"Could not open folder: {ex.Message}";
            StateHasChanged();
        }
    }
    
    private void SelectCustomDirectory()
    {
        showCustomPathInput = true;
        if (string.IsNullOrEmpty(customPath) && selectedDrive != null)
        {
            customPath = selectedDrive.Name;
        }
    }
    
    private async Task AnalyzeCustomPath()
    {
        if (string.IsNullOrEmpty(customPath)) return;
        
        showCustomPathInput = false;
        selectedDrive = null;
        analyzedPath = customPath;
        
        AddToRecentDirectories(customPath);
        
        await AnalyzePath(customPath);
    }
    
    private async Task AnalyzeCustomPath(string path)
    {
        customPath = path;
        await AnalyzeCustomPath();
    }
    
    private void AddToRecentDirectories(string path)
    {
        // Don't add if already in the list
        if (recentDirectories.Contains(path))
        {
            // Move to top if exists
            recentDirectories.Remove(path);
            recentDirectories.Insert(0, path);
            return;
        }
        
        // Add to start of list
        recentDirectories.Insert(0, path);
        
        // Limit the number of recent directories
        if (recentDirectories.Count > MAX_RECENT_DIRS)
        {
            recentDirectories.RemoveAt(recentDirectories.Count - 1);
        }
    }
    
    private string GetShortPath(string path)
    {
        if (string.IsNullOrEmpty(path)) return path;
        
        // If path is too long, truncate the middle
        if (path.Length > 40)
        {
            var start = path.Substring(0, 20);
            var end = path.Substring(path.Length - 20);
            return $"{start}...{end}";
        }
        
        return path;
    }
    
    private async Task AnalyzePath(string path)
    {
        try
        {
            storageError = null;
            largestFolders.Clear();
            fileAgeAnalysis.Clear();
            // fileTypeAnalysis.Clear();
            StateHasChanged();
            
            // Check if directory exists
            if (!Directory.Exists(path))
            {
                storageError = $"Directory not found: {path}";
                StateHasChanged();
                return;
            }
            
            // Set a timeout for folder analysis to prevent long waits
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            
            try
            {
                // Get largest folders (your existing code)
                largestFolders = await StorageService.GetLargestFoldersAsync(path, 10);
                
                // Now also analyze file ages
                await AnalyzeFileAges();
                
                if (!largestFolders.Any())
                {
                    storageError = "No accessible folders found or directory is empty.";
                }
            }
            catch (TaskCanceledException)
            {
                storageError = "Analysis took too long and was canceled. Try a different folder.";
            }
            catch (OperationCanceledException)
            {
                storageError = "Analysis took too long and was canceled. Try a different folder.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            storageError = "Access denied. Some folders could not be analyzed. Results may be incomplete.";
            // Still show any folders we did manage to scan
        }
        catch (Exception ex)
        {
            storageError = $"Error analyzing folders: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task SelectFolderAndAnalyze()
    {
        try
        {
            string selectedPath = SelectFolder("Choose a folder to analyze");

            if (!string.IsNullOrEmpty(selectedPath))
            {
                customPath = selectedPath;
                System.Diagnostics.Debug.WriteLine($"Selected folder: {selectedPath}");
                await AnalyzeCustomPath();
            }
        }
        catch (Exception ex)
        {
            storageError = $"Error selecting folder: {ex.Message}";
            System.Diagnostics.Debug.WriteLine($"Error in SelectFolderAndAnalyze: {ex}");
            StateHasChanged();
        }
    }
    
    public string SelectFolder(string title = "Select a folder")
    {
        try
        {
            // Create a dummy file dialog
            using (var dialog = new OpenFileDialog())
            {
                dialog.Title = title;
                dialog.CheckFileExists = false;
                dialog.CheckPathExists = true;
                dialog.FileName = "Select Folder"; // Placeholder filename
            
                // This makes the dialog act like a folder picker
                dialog.ValidateNames = false;
                dialog.InitialDirectory = Environment.GetFolderPath(Environment.SpecialFolder.Desktop);
            
                if (dialog.ShowDialog() == DialogResult.OK)
                {
                    // Return the directory path, not the file
                    return Path.GetDirectoryName(dialog.FileName);
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error selecting folder: {ex.Message}");
        }
    
        return string.Empty;
    }

    private async Task SelectDrive(SystemStorageService.DiskInfo drive)
    {
        try
        {
            selectedDrive = drive;
            customPath = "";
            analyzedPath = drive.Name;
            storageError = null;
            largestFolders.Clear();
            StateHasChanged();
            
            await AnalyzePath(drive.Name);
        }
        catch (Exception ex)
        {
            storageError = $"Error selecting drive: {ex.Message}";
            StateHasChanged();
        }
    }
    
    private async Task AnalyzeOldFiles()
    {
        if (string.IsNullOrEmpty(analyzedPath)) return;
        
        try
        {
            isAnalyzingOldFiles = true;
            oldFiles.Clear();
            StateHasChanged();
            
            // Get the date one year ago
            DateTime oneYearAgo = DateTime.Now.AddYears(-1);
            
            // Create a List to store old files
            var files = new List<FileInfo>();
            
            await Task.Run(() => {
                // You might need to implement this method in your StorageService
                // or use the code below as an alternative
                oldFiles = FindFilesOlderThan(analyzedPath, oneYearAgo);
            });
            
            // Sort by size to find largest old files
            oldFiles = oldFiles.OrderByDescending(f => f.Length).Take(100).ToList();
            
        }
        catch (Exception ex)
        {
            storageError = $"Error analyzing old files: {ex.Message}";
        }
        finally
        {
            isAnalyzingOldFiles = false;
            StateHasChanged();
        }
    }
    
    // Helper method to find files older than a specific date
    private List<FileInfo> FindFilesOlderThan(string path, DateTime date)
    {
        var result = new List<FileInfo>();
        try
        {
            // Use a stack for a non-recursive directory traversal
            var directories = new Stack<string>();
            directories.Push(path);
            
            while (directories.Count > 0)
            {
                string currentDir = directories.Pop();
                
                // Process files in current directory
                try
                {
                    foreach (var file in Directory.GetFiles(currentDir))
                    {
                        try
                        {
                            var fileInfo = new FileInfo(file);
                            // Check if the file is older than the specified date
                            if (fileInfo.CreationTime < date || fileInfo.LastWriteTime < date)
                            {
                                result.Add(fileInfo);
                            }
                        }
                        catch (UnauthorizedAccessException) { /* Skip inaccessible files */ }
                        catch (Exception) { /* Skip problematic files */ }
                    }
                }
                catch (UnauthorizedAccessException) { /* Skip inaccessible directories */ }
                catch (Exception) { /* Skip problematic directories */ }
                
                // Add subdirectories to the stack
                try
                {
                    foreach (var dir in Directory.GetDirectories(currentDir))
                    {
                        directories.Push(dir);
                    }
                }
                catch (UnauthorizedAccessException) { /* Skip inaccessible directories */ }
                catch (Exception) { /* Skip problematic directories */ }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error finding old files: {ex.Message}");
        }
        
        return result;
    }
    
    // You should also add this method to populate the fileAgeAnalysis list
    private async Task AnalyzeFileAges()
    {
        if (string.IsNullOrEmpty(analyzedPath)) return;
        
        try
        {
            fileAgeAnalysis.Clear();
            
            // Define age categories
            var categories = new List<(string Description, TimeSpan Age)>
            {
                ("Last 24 hours", TimeSpan.FromDays(1)),
                ("Last week", TimeSpan.FromDays(7)),
                ("Last month", TimeSpan.FromDays(30)),
                ("Last 3 months", TimeSpan.FromDays(90)),
                ("Last year", TimeSpan.FromDays(365)),
                ("Older than a year", TimeSpan.MaxValue)
            };
            
            // Initialize counters for each category
            var categoryData = categories.Select(c => new FileAgeInfo { 
                Description = c.Description,
                Size = 0,
                Count = 0,
                Percentage = 0
            }).ToList();
            
            long totalSize = 0;
            
            // This would be much better implemented in your StorageService
            await Task.Run(() => {
                // Use a stack for a non-recursive directory traversal
                var directories = new Stack<string>();
                directories.Push(analyzedPath);
                
                while (directories.Count > 0)
                {
                    string currentDir = directories.Pop();
                    
                    // Process files in current directory
                    try
                    {
                        foreach (var file in Directory.GetFiles(currentDir))
                        {
                            try
                            {
                                var fileInfo = new FileInfo(file);
                                var fileAge = DateTime.Now - fileInfo.LastWriteTime;
                                
                                // Find the appropriate category
                                for (int i = 0; i < categories.Count; i++)
                                {
                                    if (fileAge <= categories[i].Age)
                                    {
                                        categoryData[i].Size += fileInfo.Length;
                                        categoryData[i].Count++;
                                        totalSize += fileInfo.Length;
                                        break;
                                    }
                                }
                            }
                            catch (UnauthorizedAccessException) { /* Skip inaccessible files */ }
                            catch (Exception) { /* Skip problematic files */ }
                        }
                    }
                    catch (UnauthorizedAccessException) { /* Skip inaccessible directories */ }
                    catch (Exception) { /* Skip problematic directories */ }
                    
                    // Add subdirectories to the stack
                    try
                    {
                        foreach (var dir in Directory.GetDirectories(currentDir))
                        {
                            directories.Push(dir);
                        }
                    }
                    catch (UnauthorizedAccessException) { /* Skip inaccessible directories */ }
                    catch (Exception) { /* Skip problematic directories */ }
                }
            });
            
            // Calculate percentages
            if (totalSize > 0)
            {
                foreach (var category in categoryData)
                {
                    category.Percentage = Math.Round((double)category.Size / totalSize * 100, 1);
                }
            }
            
            // Filter out empty categories and add to the analysis result
            fileAgeAnalysis = categoryData.Where(c => c.Count > 0).ToList();
        }
        catch (Exception ex)
        {
            storageError = $"Error analyzing file ages: {ex.Message}";
        }
        
        StateHasChanged();
    }
    
    // Add this class definition inside your @code block
    private class FileAgeInfo
    {
        public string Description { get; set; } = "";
        public long Size { get; set; }
        public int Count { get; set; }
        public double Percentage { get; set; }
        
        // Use a property that calculates the formatted size instead of calling the service
        public string SizeFormatted => FormatSize(Size);
        
        // Private helper method to format file sizes
        private string FormatSize(long bytes)
        {
            string[] suffixes = { "B", "KB", "MB", "GB", "TB", "PB" };
            int counter = 0;
            decimal number = bytes;
            
            while (Math.Round(number / 1024) >= 1)
            {
                number /= 1024;
                counter++;
            }
            
            return $"{number:n1} {suffixes[counter]}";
        }
    }
    
    public void Dispose()
    {
        _timer?.Dispose();
    }
}
