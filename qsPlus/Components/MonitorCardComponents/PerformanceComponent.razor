@using qsPlus.Services
@using qsPlus.Components.MonitorCardComponents
@inject SystemPerformanceService PerformanceService
@implements IDisposable
    
<div class="row row-cols-1 g-4">
    <div class="col">
        <div class="card performance-card h-100">
            @* <h4 class="card-title text-center mb-0">System Metrics</h4> *@
            
            <div class="card-body p-4">
                @if (!isLoaded)
                {
                    <div class="text-center my-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading system metrics...</p>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="performance-item">
                                <span class="label">Uptime</span>
                                <span class="value">@PerformanceService.GetFormattedUptime()</span>
                            </div>
                            
                            <div class="performance-item">
                                <span class="label">Operating System</span>
                                <span class="value">@PerformanceService.GetOperatingSystemInfo()</span>
                            </div>
                            
                            <div class="performance-item">
                                <span class="label">Processors</span>
                                <span class="value">@PerformanceService.GetProcessorCount()</span>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="performance-item @(cpuUsage > 80 ? "critical" : cpuUsage > 60 ? "warning" : "")">
                                <span class="label">CPU Usage</span>
                                <div class="d-flex justify-content-between">
                                    <span class="value">@cpuUsage.ToString("0.0")%</span>
                                    <i class="@(cpuUsage > 80 ? "bi bi-exclamation-triangle text-danger" : 
                                                cpuUsage > 60 ? "bi bi-exclamation-circle text-warning" : 
                                                "bi bi-check-circle text-success")"></i>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress" style="width: @cpuUsage%"></div>
                                </div>
                            </div>
                            
                            <div class="performance-item">
                                <span class="label">Available RAM</span>
                                <span class="value">@availableRam.ToString("N0") MB / @totalRam.ToString("N0") MB</span>
                                <div class="progress-bar">
                                    <div class="progress" style="width: @(100 - (availableRam / totalRam * 100))%"></div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <button class="btn btn-sm btn-primary rounded-pill shadow-sm" @onclick="ManualRefresh">
                                    <i class="bi bi-arrow-repeat me-1"></i> Refresh
                                </button>
                            </div>
                        </div>

                        @if (lastError != null)
                        {
                            <div class="col-12 mt-3">
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    @lastError
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private double cpuUsage = 0;
    private double availableRam = 0;
    private double totalRam = 1;
    private System.Threading.Timer? _timer;
    private bool isLoaded = false;
    private string? lastError = null;
    private int failedAttempts = 0;
    private bool _isMounted = false;
    
    protected override void OnInitialized()
    {
        // Get static data synchronously
        try
        {
            totalRam = PerformanceService.GetTotalRamInMB();
        }
        catch (Exception ex)
        {
            lastError = $"Error getting total RAM: {ex.Message}";
            totalRam = 8192; // fallback
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isMounted = true;
            await UpdateDataSafely();
            
            // Setup timer only after first successful update
            _timer = new System.Threading.Timer(_ => 
            {
                InvokeAsync(UpdateDataSafely);
            }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(5));
        }
    }
    
    private async Task ManualRefresh()
    {
        await UpdateDataSafely();
    }
    
    private async Task UpdateDataSafely()
    {
        if (!_isMounted) return;
        
        try
        {
            lastError = null;
            
            // Update CPU data
            try 
            {
                cpuUsage = PerformanceService.GetCpuUsage();
            }
            catch (Exception ex)
            {
                lastError = $"CPU data error: {ex.Message}";
            }
            
            // Update RAM data
            try 
            {
                availableRam = PerformanceService.GetAvailableRamInMB();
            }
            catch (Exception ex)
            {
                if (lastError == null)
                    lastError = $"RAM data error: {ex.Message}";
            }
            
            if (!isLoaded)
                isLoaded = true;
                
            failedAttempts = 0;
        }
        catch (Exception ex)
        {
            failedAttempts++;
            lastError = $"Update error: {ex.Message}";
        }
        
        await InvokeAsync(StateHasChanged);
    }
    
    public void Dispose()
    {
        _isMounted = false;
        _timer?.Dispose();
    }
}