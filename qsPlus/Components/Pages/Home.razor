@page "/"
@using System.Diagnostics
@using System.Timers
@implements IDisposable

<PageTitle>System Monitor</PageTitle>

<div class="container">
    <h1>System Monitor</h1>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">CPU Usage</div>
                <div class="card-body">
                    <h2>@cpuUsage%</h2>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">Available Memory</div>
                <div class="card-body">
                    <h2>@availableMemory MB</h2>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">System Uptime</div>
                <div class="card-body">
                    <h2 class="@GetUptimeClass()">@sysUpTimeValue</h2>
                    @if (uptimeHours >= 12)
                    {
                        <div class="alert alert-warning mt-2">
                            Consider restarting your computer
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PerformanceCounter cpuCounter;
    private PerformanceCounter memCounter;
    private PerformanceCounter systemCounter;
    private System.Timers.Timer timer;
    
    private float cpuUsage = 0;
    private float availableMemory = 0;
    private string sysUpTimeValue = "0 Hours";
    private int uptimeHours = 0;
    private DateTime lastAlertTime = DateTime.MinValue;

    protected override void OnInitialized()
    {
        try
        {
            cpuCounter = new PerformanceCounter("Processor Information", "% Processor Time", "_Total");
            memCounter = new PerformanceCounter("Memory", "Available MBytes");
            systemCounter = new PerformanceCounter("System", "System Up Time");
            
            timer = new System.Timers.Timer(2000);
            timer.Elapsed += UpdateCounters;
            timer.AutoReset = true;
            timer.Start();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing performance counters: {ex.Message}");
        }
    }

    private void UpdateCounters(object sender, ElapsedEventArgs e)
    {
        try
        {
            cpuUsage = cpuCounter?.NextValue() ?? 0;
            availableMemory = memCounter?.NextValue() ?? 0;
            UpdateSystemUptime();
            
            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating counters: {ex.Message}");
        }
    }

    private void UpdateSystemUptime()
    {
        if (systemCounter == null) return;
        
        uptimeHours = (int)(systemCounter.NextValue() / 60 / 60);
        sysUpTimeValue = $"{uptimeHours} Hours";

        if (uptimeHours >= 24)
        {
            sysUpTimeValue += " -- ** Restart Required **";
            CheckAndSendAlert("Time To Restart", $"Your computer has been on for: {uptimeHours} hours. Consider restarting it.");
        }
        else if (uptimeHours >= 12)
        {
            sysUpTimeValue += " -- ** Restart Recommended **";
            CheckAndSendAlert("Time To Restart", $"Your computer has been on for: {uptimeHours} hours. Consider restarting it.");
        }
    }

    private string GetUptimeClass()
    {
        if (uptimeHours >= 24) return "text-danger";
        if (uptimeHours >= 12) return "text-warning";
        if (uptimeHours >= 6) return "text-warning-light";
        return "";
    }

    private void CheckAndSendAlert(string title, string message)
    {
        // In Blazor we can't use system notifications directly
        // This is just a placeholder - you could implement a toast notification here
        if ((DateTime.Now - lastAlertTime).TotalMinutes > 15)
        {
            // Console.WriteLine($"{title}: {message}");
            lastAlertTime = DateTime.Now;
        }
    }

    public void Dispose()
    {
        timer?.Stop();
        timer?.Dispose();
        
        cpuCounter?.Dispose();
        memCounter?.Dispose();
        systemCounter?.Dispose();
    }
}